rules_version = '2';

// ⚠️ قالب مقترح — راجعه في Firebase Console ← Firestore ← Rules ← "Rules Playground"
// قبل ما تنشره. ما اتجرّبش على مشروعك (agri-dahshory).
//
// الأدمن: مستند في collection اسمه admins، ID المستند = uid الأدمن
// (تنشئه بإيدك من الـ Console بعد ما الأدمن يسجّل دخول مرة). مفيش أي طريقة
// يعمل بيها مستخدم عادي نفسه أدمن لأن الكتابة على admins ممنوعة بالكامل.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // لا أحد يكتب هنا من التطبيق
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ملف المستخدم: صاحبه فقط، وبالحقول التي يكتبها التطبيق حالياً.
    function validUserName() {
      return request.resource.data.name is string
        // size() في Rules يقيس حجم النص بالبايت؛ 400 بايت يغطي 100
        // حرف Unicode تقريباً، مع إبقاء اسم الملف الشخصي غير فارغ.
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 400;
    }

    function validUserPhone() {
      // التطبيق يحفظ الرقم بعد التطبيع إلى أرقام إنجليزية (رقم مصري).
      return request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[0125][0-9]{8}$');
    }

    function validUserDocumentShape() {
      return request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'createdAt'
        ])
        && request.resource.data.uid is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // التسجيل ينشئ المستند بالحقول الأربعة نفسها التي يرسلها AuthService.
      // serverTimestamp() يُقيَّد بوقت الطلب حتى لا يزوّر العميل تاريخ الإنشاء.
      allow create: if signedIn()
        && request.auth.uid == uid
        && validUserDocumentShape()
        && request.resource.data.uid == uid
        && validUserName()
        && validUserPhone()
        && request.resource.data.createdAt == request.time;

      // شاشة الملف الشخصي تستخدم set(..., merge: true) لتعديل الاسم فقط.
      // uid والهاتف وتاريخ الإنشاء غير قابلين للتغيير من التطبيق.
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && validUserDocumentShape()
        && request.resource.data.uid == uid
        && validUserName()
        && validUserPhone()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name']);

      allow delete: if false;
    }

    // التشخيصات: صاحبها يكتب (create) ويقرأ، الأدمن يقرأ
    match /diagnoses/{id} {
      function validDiagnosisShape() {
        return request.resource.data.keys().hasAll([
            'uid', 'userName', 'userPhone', 'question', 'diagnosis',
            'createdAt', 'syncedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'userName', 'userPhone', 'question', 'diagnosis',
            'createdAt', 'syncedAt'
          ])
          && request.resource.data.uid is string
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 400
          && request.resource.data.userPhone is string
          && request.resource.data.userPhone.size() <= 32
          && request.resource.data.question is string
          && request.resource.data.question.size() <= 10000
          && request.resource.data.diagnosis is string
          && request.resource.data.diagnosis.size() <= 20000
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 64
          && request.resource.data.syncedAt == request.time;
      }

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && validDiagnosisShape();
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // المزامنة بتكتب بمعرّف ثابت (set). لو الرفع نجح قبل كده وحالة الصف
      // المحلي ما اتحدّثتش، إعادة المحاولة بتكتب نفس المستند وبتتحسب update،
      // فنسمح بيها لصاحب المستند بس وبدون تغيير الـ uid. الحذف ممنوع.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && validDiagnosisShape();
      allow delete: if false;
    }

    // برامج المزرعة: صاحب البرنامج فقط
    match /my_farm/{id} {
      function validFarmProgramShape() {
        return request.resource.data.keys().hasAll([
            'user_id', 'template_id', 'template_name', 'template_emoji',
            'section_id', 'section_name', 'governorate', 'climate_zone',
            'area_unit', 'input_values', 'irrigation_plan', 'tasks',
            'materials', 'financial', 'start_date', 'created_at', 'status',
            'done_tasks'
          ])
          && request.resource.data.keys().hasOnly([
            'user_id', 'template_id', 'template_name', 'template_emoji',
            'section_id', 'section_name', 'governorate', 'climate_zone',
            'area_unit', 'input_values', 'irrigation_plan', 'tasks',
            'materials', 'financial', 'start_date', 'created_at', 'status',
            'done_tasks'
          ])
          && request.resource.data.user_id is string
          && request.resource.data.template_id is string
          && request.resource.data.template_id.size() <= 256
          && request.resource.data.template_name is string
          && request.resource.data.template_name.size() <= 400
          && request.resource.data.template_emoji is string
          && request.resource.data.template_emoji.size() <= 64
          && request.resource.data.section_id is string
          && request.resource.data.section_id.size() <= 256
          && request.resource.data.section_name is string
          && request.resource.data.section_name.size() <= 400
          && request.resource.data.governorate is string
          && request.resource.data.governorate.size() <= 400
          && request.resource.data.climate_zone is string
          && request.resource.data.climate_zone.size() <= 400
          && request.resource.data.area_unit is string
          && request.resource.data.area_unit.size() <= 100
          && request.resource.data.input_values is map
          && request.resource.data.input_values.size() <= 100
          && request.resource.data.irrigation_plan is map
          && request.resource.data.irrigation_plan.size() <= 100
          && request.resource.data.tasks is list
          && request.resource.data.tasks.size() <= 200
          && request.resource.data.materials is list
          && request.resource.data.materials.size() <= 200
          && request.resource.data.financial is map
          && request.resource.data.financial.size() <= 100
          && request.resource.data.start_date is timestamp
          && request.resource.data.created_at == request.time
          && request.resource.data.status in ['active', 'completed']
          && request.resource.data.done_tasks is list
          && request.resource.data.done_tasks.size() <= 200;
      }

      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && validFarmProgramShape();
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      // تعديل: نفس الصاحب، ولا يغيّر الـ user_id
      allow update: if signedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'done_tasks', 'status', 'irrigation_plan'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['done_tasks'])
            || (request.resource.data.done_tasks is list
              && request.resource.data.done_tasks.size()
                  <= resource.data.tasks.size()))
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['status'])
            || request.resource.data.status in ['active', 'completed'])
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['irrigation_plan'])
            || (request.resource.data.irrigation_plan is map
              && request.resource.data.irrigation_plan.size() <= 100));

      match /plant_health_cases/{caseId} {
        function ownsParentProgram() {
          return signedIn()
            && get(/databases/$(database)/documents/my_farm/$(id)).data.user_id
              == request.auth.uid;
        }

        function validPlantHealthCase() {
          return request.resource.data.keys().hasAll([
              'user_id', 'farm_crop', 'predicted_crop', 'disease', 'class_name',
              'confidence', 'model_version', 'irrigation_action',
              'irrigation_advice_ar', 'review_required', 'status', 'created_at'
            ])
            && request.resource.data.keys().hasOnly([
              'user_id', 'farm_crop', 'predicted_crop', 'disease', 'class_name',
              'confidence', 'model_version', 'irrigation_action',
              'irrigation_advice_ar', 'review_required', 'status', 'created_at'
            ])
            && request.resource.data.user_id == request.auth.uid
            && request.resource.data.farm_crop is string
            && request.resource.data.farm_crop.size() <= 320
            && request.resource.data.predicted_crop is string
            && request.resource.data.predicted_crop.size() > 0
            && request.resource.data.predicted_crop.size() <= 320
            && request.resource.data.disease is string
            && request.resource.data.disease.size() > 0
            && request.resource.data.disease.size() <= 320
            && request.resource.data.class_name is string
            && request.resource.data.class_name.size() > 0
            && request.resource.data.class_name.size() <= 320
            && request.resource.data.confidence is number
            && request.resource.data.confidence >= 0
            && request.resource.data.confidence <= 1
            && request.resource.data.model_version is string
            && request.resource.data.model_version.size() <= 100
            && request.resource.data.irrigation_action == 'monitor_and_review'
            && request.resource.data.irrigation_advice_ar is string
            && request.resource.data.irrigation_advice_ar.size() > 0
            && request.resource.data.irrigation_advice_ar.size() <= 2000
            && request.resource.data.review_required == true
            && request.resource.data.status == 'needs_agronomist_review'
            && request.resource.data.created_at == request.time;
        }

        allow read: if ownsParentProgram();
        allow create: if ownsParentProgram() && validPlantHealthCase();
        allow update: if false;
        allow delete: if ownsParentProgram();
      }
    }

    // الحاسبات والموسوعة: القراءة لأي مستخدم مسجّل، الكتابة للأدمن فقط
    match /calculator_sections/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /calculator_templates/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /encyclopedia_sections/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /encyclopedia_items/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // صور التدريب وتسمياتها لا يصل إليها إلا الأدمن. لا يسمح العميل بتعديل
    // أو حذف العينات بعد حفظها، للحفاظ على سجل البيانات الذي سيُستخدم لاحقاً.
    function validTrainingSample(sampleId) {
      return request.resource.data.keys().hasAll([
          'crop', 'disease', 'className', 'storagePath', 'mimeType',
          'sizeBytes', 'uploadedByUid', 'uploadedAt', 'status',
          'labelConfirmedByAgronomist', 'source'
        ])
        && request.resource.data.keys().hasOnly([
          'crop', 'disease', 'className', 'storagePath', 'mimeType',
          'sizeBytes', 'uploadedByUid', 'uploadedAt', 'status',
          'labelConfirmedByAgronomist', 'source'
        ])
        && request.resource.data.crop is string
        && request.resource.data.crop.size() > 0
        && request.resource.data.crop.size() <= 320
        && request.resource.data.disease is string
        && request.resource.data.disease.size() > 0
        && request.resource.data.disease.size() <= 320
        && request.resource.data.className == request.resource.data.crop + '__' + request.resource.data.disease
        && request.resource.data.className.size() <= 642
        && request.resource.data.storagePath is string
        && (
          (request.resource.data.storagePath == 'plant_training/' + request.auth.uid + '/' + sampleId + '.jpg'
            && request.resource.data.mimeType == 'image/jpeg')
          || (request.resource.data.storagePath == 'plant_training/' + request.auth.uid + '/' + sampleId + '.jpeg'
            && request.resource.data.mimeType == 'image/jpeg')
          || (request.resource.data.storagePath == 'plant_training/' + request.auth.uid + '/' + sampleId + '.png'
            && request.resource.data.mimeType == 'image/png')
          || (request.resource.data.storagePath == 'plant_training/' + request.auth.uid + '/' + sampleId + '.webp'
            && request.resource.data.mimeType == 'image/webp')
        )
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 10 * 1024 * 1024
        && request.resource.data.uploadedByUid == request.auth.uid
        && request.resource.data.uploadedAt == request.time
        && request.resource.data.status == 'pending_training'
        && request.resource.data.labelConfirmedByAgronomist == true
        && request.resource.data.source == 'admin_training_portal';
    }

    match /plant_training_samples/{sampleId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validTrainingSample(sampleId);
      allow update, delete: if false;
    }

    // لا يقرأ العميل الرمز أو بيانات الأجهزة. إنشاء/تحديث التسجيل يمر عبر
    // registerWeatherPushDevice لفرض سقف الأجهزة وتدوير الموقع على الخادم.
    match /users/{uid}/weather_push_devices/{token} {
      allow read: if false;
      allow create, update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // مفاتيح منع تكرار الإشعارات لا يكتبها ولا يقرأها تطبيق العميل.
    match /users/{uid}/weather_push_state/{deviceKey} {
      allow read, write: if false;
    }

    // أي حاجة تانية ممنوعة
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
