rules_version = '2';

// ⚠️ قالب مقترح — راجعه في Firebase Console ← Firestore ← Rules ← "Rules Playground"
// قبل ما تنشره. ما اتجرّبش على مشروعك (agri-dahshory).
//
// الأدمن: مستند في collection اسمه admins، ID المستند = uid الأدمن
// (تنشئه بإيدك من الـ Console بعد ما الأدمن يسجّل دخول مرة). مفيش أي طريقة
// يعمل بيها مستخدم عادي نفسه أدمن لأن الكتابة على admins ممنوعة بالكامل.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // لا أحد يكتب هنا من التطبيق
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ملف المستخدم: صاحبه فقط، وبالحقول التي يكتبها التطبيق حالياً.
    function validUserName() {
      return request.resource.data.name is string
        // size() في Rules يقيس حجم النص بالبايت؛ 400 بايت يغطي 100
        // حرف Unicode تقريباً، مع إبقاء اسم الملف الشخصي غير فارغ.
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 400;
    }

    function validUserPhone() {
      // التطبيق يحفظ الرقم بعد التطبيع إلى أرقام إنجليزية (رقم مصري).
      return request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[0125][0-9]{8}$');
    }

    function validUserDocumentShape() {
      return request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'createdAt'
        ])
        && request.resource.data.uid is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // التسجيل ينشئ المستند بالحقول الأربعة نفسها التي يرسلها AuthService.
      // serverTimestamp() يُقيَّد بوقت الطلب حتى لا يزوّر العميل تاريخ الإنشاء.
      allow create: if signedIn()
        && request.auth.uid == uid
        && validUserDocumentShape()
        && request.resource.data.uid == uid
        && validUserName()
        && validUserPhone()
        && request.resource.data.createdAt == request.time;

      // شاشة الملف الشخصي تستخدم set(..., merge: true) لتعديل الاسم فقط.
      // uid والهاتف وتاريخ الإنشاء غير قابلين للتغيير من التطبيق.
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && validUserDocumentShape()
        && request.resource.data.uid == uid
        && validUserName()
        && validUserPhone()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name']);

      allow delete: if false;
    }

    // التشخيصات: صاحبها يكتب (create) ويقرأ، الأدمن يقرأ
    match /diagnoses/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // المزامنة بتكتب بمعرّف ثابت (set). لو الرفع نجح قبل كده وحالة الصف
      // المحلي ما اتحدّثتش، إعادة المحاولة بتكتب نفس المستند وبتتحسب update،
      // فنسمح بيها لصاحب المستند بس وبدون تغيير الـ uid. الحذف ممنوع.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // برامج المزرعة: صاحب البرنامج فقط
    match /my_farm/{id} {
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      // تعديل: نفس الصاحب، ولا يغيّر الـ user_id
      allow update: if signedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
    }

    // الحاسبات والموسوعة: القراءة لأي مستخدم مسجّل، الكتابة للأدمن فقط
    match /calculator_sections/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /calculator_templates/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /encyclopedia_sections/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /encyclopedia_items/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // تسجيل رمز FCM لكل تثبيت. موقع المزرعة تقريبي ولا يُكتب إلا لحساب صاحبه.
    // لا يقرأ العميل الرمز أو بيانات الأجهزة؛ Functions يستخدم Admin SDK.
    match /users/{uid}/weather_push_devices/{token} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'token', 'latitude', 'longitude', 'enabled', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'token', 'latitude', 'longitude', 'enabled', 'updatedAt'
        ])
        && request.resource.data.token is string
        && request.resource.data.token == token
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 1500
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.enabled == true
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // مفاتيح منع تكرار الإشعارات لا يكتبها ولا يقرأها تطبيق العميل.
    match /users/{uid}/weather_push_state/{deviceKey} {
      allow read, write: if false;
    }

    // أي حاجة تانية ممنوعة
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
